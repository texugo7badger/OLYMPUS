# ─── OLYMPUS npm configuration ───────────────────────────────────────────
# See the install troubleshooting notes in the project README.

# Skip `npm audit` at the end of `npm install`.
# OLYMPUS pulls in Electron (~hundreds of advisories) and a large dev tree;
# computing the metavuln graph every install is slow AND was the cause of the
# 2026-07-28 install that exited `code 1` (the process was interrupted while
# still in the audit phase, leaving every npm timer "unfinished"). Audit does
# not affect what gets installed — it only reports. Run `npm audit` manually
# when you actually want a report.
audit=false

# Suppress package funding notices (noise after every install).
fund=false

# Disable the TTY progress bar so logs are clean / diff-friendly.
progress=false

# ─── Suppress deprecation / advisory warnings (clean one-click install) ─────
# npm has no targeted "hide only deprecations" switch — it gates ALL output by
# log level. The remaining warnings on `npm install` are cosmetic UPSTREAM
# deprecations nested inside pinned transitive trees (inflight, glob@7/9,
# rimraf@2, boolean) whose latest majors are ESM-only and would break the CJS
# parents (electron-builder/@opencode-ai-plugin). They cannot be removed from
# package.json and are unreachable at runtime. See STEP-3-NOTES in the repo.
#
# `loglevel=error` therefore hides warn-level output (deprecations + ERESOLVE
# notices + the install-scripts notice lines) so the install prints only real
# errors (none remain) and the project's own postinstall banners.
#
# Tradeoff: this ALSO hides any FUTURE legitimate warnings. If an install ever
# behaves wrongly, temporarily comment this line out (or run with
# `--loglevel=warn`) to see the suppressed warnings again.
loglevel=error

# ─── Lifecycle scripts (npm >=12 default-deny) ───────────────────────────────
# npm 12 hardened install-script policy: by default it BLOCKS every package's
# install/postinstall script and emits a `npm warn install-scripts ... blocked`
# warning, leaving native modules unbuilt (better-sqlite3, node-pty, electron,
# esbuild, sharp, opencode-ai, etc.).
#
# The supported opt-in for PROJECT installs is the `allowScripts` field in
# package.json (see there) — NOT this .npmrc key. `allow-scripts` in .npmrc is
# reserved for global/npx installs and would be ignored (or rejected as the
# `--allow-scripts` CLI flag with EALLOWSCRIPTS for project installs).
#
# If you add a new native dependency later, refresh the approvals with:
#   npm install-scripts approve --all
# or pin just the new one:  npm install-scripts approve <pkg>