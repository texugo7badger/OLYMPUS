{
  "name": "olympus",
  "version": "0.0.37",
  "description": "Olympus — automated multi-agent operating system built on OpenCode. 10 gods, cascading token compression, self-curating brain. Packaged as a standalone Electron desktop app.",
  "author": "OLYMPUS Contributors",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "olympus": "bin/olympus.js"
  },
  "main": "dist-electron-tsc/main.js",
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "electron/",
    ".opencode/",
    "brain-atlas/",
    "public/",
    "opencode.json",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CREDITS.md",
    "README.md",
    "TOKEN-ECONOMY.md",
    "EDITORS.md",
    "MODEL-STRATEGIES.md",
    "BENCHMARKS.md",
    "BUILD-AND-PUBLISH.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "next.config.ts",
    "next-env.d.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "components.json"
  ],
  "scripts": {
    "dev": "npm run rebuild:native && electron . --dev",
    "build": "next build && node scripts/sync-standalone-assets.mjs && node scripts/verify-standalone.mjs && tsc -p electron/tsconfig.json && node scripts/electron-postcompile.js && electron-builder",
    "build:app": "next build && node scripts/sync-standalone-assets.mjs && node scripts/verify-standalone.mjs && tsc -p electron/tsconfig.json && node scripts/electron-postcompile.js",
    "build:linux": "next build && node scripts/sync-standalone-assets.mjs && node scripts/verify-standalone.mjs && tsc -p electron/tsconfig.json && node scripts/electron-postcompile.js && electron-builder --linux",
    "start": "electron .",
    "lint": "eslint . --no-warn-ignored",
    "lint:fix": "eslint . --fix --no-warn-ignored",
    "security:audit": "npm audit --audit-level=high",
    "apply-strategy": "node scripts/apply-strategy.js",
    "check-strategy-sync": "node scripts/check-strategy-sync.js",
    "install-opencode": "node scripts/install-opencode.js",
    "rebuild:native": "node scripts/rebuild-native.js",
    "setup": "bash scripts/install/install.sh",
    "detect-editors": "node scripts/detect-editors.js",
    "eval": "node scripts/eval/harness/runner.js",
    "eval:html": "node scripts/eval/harness/runner.js --report html",
    "vault-prune": "node scripts/vault-prune.js",
    "settings-export": "node scripts/settings-export-import.js export",
    "settings-import": "node scripts/settings-export-import.js import",
    "skill-index": "node scripts/build-skill-index.js",
    "skill-index:watch": "node scripts/incremental-skill-index.js",
    "skill-index:once": "node scripts/incremental-skill-index.js --once",
    "test-demigod": "node scripts/test-demigod.js",
    "battery": "node scripts/battery.mjs",
    "fix-types": "node scripts/fix-types.js",
    "electron:compile": "tsc -p electron/tsconfig.json && node scripts/electron-postcompile.js",
    "overlay:compile": "tsc -p .opencode/olympus/tsconfig.json && node scripts/olympus-overlay-postcompile.js",
    "plugins:compile": "tsc -p .opencode/tsconfig.plugins.json",
    "electron:dev": "concurrently -k -n next,electron -c cyan,magenta \"next dev -p 3737 -H 127.0.0.1\" \"wait-on http://localhost:3737/api/olympus/health && npm run rebuild:native && tsc -p electron/tsconfig.json && node scripts/electron-postcompile.js && electron .\"",
    "olympus": "node bin/olympus.js",
    "postinstall": "node scripts/postinstall.js",
    "prebuild": "node scripts/invalidate-build-stamp.js",
    "prebuild:app": "node scripts/invalidate-build-stamp.js",
    "prebuild:linux": "node scripts/invalidate-build-stamp.js",
    "gods:check": "node scripts/gods-check.mjs",
    "mcp:vendor": "node scripts/mcp-vendor.mjs",
    "mcp:audit": "npx tsx scripts/mcp-audit.ts",
    "mcp:sync": "npx tsx scripts/mcp-sync.ts",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "perf:routes": "npx tsx scripts/perf-routes.mjs",
    "seed:knowledge": "node scripts/seed-knowledge-base.mjs",
    "projects:migrate": "node scripts/migrate-projects-to-vault.mjs",
    "local:probe": "node scripts/local-llm-probe.js",
    "badges:update": "node scripts/update-badges.mjs",
    "measure:close": "npx tsx scripts/measure-close.test.mjs",
    "opencode:gate": "node scripts/opencode-gate.mjs",
    "repo:privacy": "node scripts/check-repo-privacy.mjs",
    "shots": "electron scripts/capture-ui.cjs --no-sandbox",
    "themes:gallery": "tsx scripts/theme-gallery.mjs"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@google/model-viewer": "^4.4.0",
    "@opencode/cli": "^2.2.5",
    "@opencode/plugin": "^2.2.5",
    "@radix-ui/primitive": "^1.2.0",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.10",
    "isomorphic-git": "^1.40.0",
    "node-pty": "^1.1.0",
    "sqlite-vec": "^0.1.9",
    "three": "^0.183.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^4.2.1",
    "@fission-ai/openspec": "^1.7.0",
    "@opencode-ai/plugin": "^1.19.5",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.0.7",
    "next": "^16.4.2",
    "opencode-ai": "^1.18.10",
    "postcss": "^8.5.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "ini": "^6.0.0",
    "@emnapi/core": "^2.0.0-alpha.3",
    "@napi-rs/wasm-runtime": "1.2.0",
    "@babel/core": "^7.29.6",
    "lodash-es": "4.18.1",
    "source-map-js": "1.2.2",
    "http-cache-semantics": "4.3.0",
    "shell-quote": "1.12.0",
    "katex": "0.19.0",
    "solid-js": "1.9.17",
    "seroval": "1.6.11",
    "seroval-plugins": "1.6.8",
    "effect": "4.0.1",
    "toml": "5.0.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "@opencode-ai/plugin": {
      "zod": "4.6.7"
    },
    "node-gyp": {
      "undici": "6.29.1"
    },
    "@electron/get": {
      "undici": "7.30.1"
    },
    "fast-uri": "3.1.9"
  },
  "allowScripts": {
    "@fission-ai/openspec": true,
    "better-sqlite3": true,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "node-pty": true,
    "opencode-ai": true,
    "sharp": true,
    "unrs-resolver": true,
    "@opencode/cli@2.0.32": true,
    "@opencode/cli": true
  },
  "optionalDependencies": {
    "@tarquinen/opencode-dcp": "^3.2.0",
    "openai": "^7.3.0",
    "opencode-pty": "^0.4.0",
    "opencode-token-monitor": "^0.5.0",
    "opencode-vibeguard": "^0.1.0"
  }
}
