# ─── Dependencies ────────────────────────────────────────────────────────
node_modules/

# ─── Build artifacts ────────────────────────────────────────────────────
.next/
dist/
.opencode/dist/
.opencode/olympus/dist/
*.tsbuildinfo

# ─── Campaign evidence reports (local-only, the 2026-10-20 directive)
reports/

# ─── Electron build artifacts ───────────────────────────────────────────
dist-electron-tsc/
dist-electron/
electron-builder-cache/

# ─── Environment & secrets ──────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
.env.production
.env.development

# API keys, tokens, credentials
*secret*
*secrets*
*credential*
*credentials*
*api-key*
*api_keys*
*apikey*
*token*
# The public share route uses a [token] SEGMENT — it is a Next.js route, not a
# secret file. Without these negations the broad *token* rule hides the route
# from git (v0.0.79).
!src/app/share/preview/\[token\]/
!src/app/share/preview/\[token\]/\[\[...path\]\]/
!src/app/share/preview/\[token\]/\[\[...path\]\]/route.ts
*tokens*

# Demigod prompt templates are source, not secrets. The broad patterns above
# (e.g. *secrets* matching artemis/secrets_scanner.txt) must never swallow a
# registry prompt file — a fresh clone would lose the demigod entirely.
!.opencode/prompts/agents/demigods/**
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts
authorized_keys

# Cloud provider credentials
.aws/
.gcp/
.azure/
kubeconfig
*.kubeconfig

# Database dumps / backups
*.sql
*.sql.gz
*.dump
*.bak
*.backup

# ─── OS files ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ─── Editor / IDE (per-user configs) ────────────────────────────────────
.idea/
*.swp
*.swo
*.swn
*.swm
*.orig
*.rej

# ─── Logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Vault (user data — never commit) ───────────────────────────────────
OLYMPUS-VAULT/

# ─── Olympus home (user config + secrets — never commit) ────────────────
.olympus/

# ─── Callimachus lockfiles ──────────────────────────────────────────────
callimachus.lock

# ─── Setup & internal docs (maintainer-only — not for public commit) ──
BUILD-AND-PUBLISH.md
WORKLOG.md

# ─── IDE extensions (committed as of v0.0.1) ───────────────────────────

# ─── Temporary & cache ──────────────────────────────────────────────────
tmp/
.cache/
*.tmp
*.temp

# ─── Test vaults (local simulation outputs) ─────────────────────────────
vault-test-*/
vault-sim/
vault-sim*/
.tmp-*.mts
.superpowers

# Private debug transcript (user session log) — never publish
Todas as estrat*deram erro* Ajuda..md

# Maintainer-only docs/research/planning — they live on the maintainer's machine, never in the repo.
docs/
research/

# Maintainer-only test suites — they read the local vault, lanes and credentials.
# The public method and the measured evidence live in TESTING.md.
scripts/*.test.mjs
!scripts/eta-model.test.mjs
!scripts/mcp-run-manifest.test.mjs

# v0.0.81 — THE PUBLIC CORE. These pure suites (no vault, no credentials)
# are published so a clone can verify the project.
!scripts/cost-caps.test.mjs
!scripts/docs-check.test.mjs
!scripts/terminal-paste.test.mjs
!scripts/preview-share.test.mjs
!scripts/alignment-preview.test.mjs
!scripts/i18n-audit.test.mjs
!scripts/theme-gallery.test.mjs
!scripts/god-chat.test.mjs
!scripts/brain-live.test.mjs
!scripts/cost-window.test.mjs

# ─── Internal development data and plans — NEVER public (golden rule) ───
# AIME/bench data, machine-local reports and session checkpoints stay on the
# maintainer's disk. The public product docs (README, ARCHITECTURE, TESTING,
# RESPONSIVE, LANGUAGES, MOBILE, TOKEN-ECONOMY, WORKFLOW) are the exception.
BENCH-AIME.md
reports/
plans/
*.plan.md
*.checkpoint.md
SESSION-CHECKPOINT*.md

